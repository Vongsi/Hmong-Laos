# Settings for deploy/docker-compose.yml and deploy/backup.sh. On the server only: copy to deploy/.env and fill
# in; it is never committed. Use letters and digits only for the passwords and the token, for example the
# output of `openssl rand -hex 24`.

# The site's address as people type it (no https://), and an email for the HTTPS certificate (Let's Encrypt).
SERVER_NAME=daimavhlub.example
ACME_EMAIL=

# The database. The site gets these from here, so leave DB_* out of the site's .env.
DB_DATABASE=daim_av_hlub
DB_USERNAME=dah
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Shared by the site and the WhatsApp sender.
WHATSAPP_SENDER_TOKEN=

# Backups (deploy/README.md → Backups). Where the encrypted copies go: the rclone remote, e.g. "dah-backup:".
# Empty: the database copies stay on the server only (Contabo's Auto Backup still takes them along).
BACKUP_REMOTE=
# Optional: a healthchecks.io ping URL, so you get an email when a night's backup didn't happen.
BACKUP_PING_URL=
