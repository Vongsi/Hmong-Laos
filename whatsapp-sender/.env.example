# Settings for the WhatsApp sender (copy to .env; see README.md). Usually not needed:
# `php artisan whatsapp:sender` passes on the website's .env (TOKEN, HOST, PORT, CALLBACK_URL and DATA_DIR from
# WHATSAPP_SENDER_URL, WHATSAPP_SENDER_TOKEN, APP_URL, WHATSAPP_SENDER_DATA_DIR; anything below set there too),
# and those win over this file. This file is for running `node server.js` by itself.
# TOKEN=
# HOST=127.0.0.1
# PORT=3100
# CALLBACK_URL=https://example.com/whatsapp/status

# Where the linked session, the queue and the history are kept. On Windows keep the path short (e.g. C:\wa-sender).
# DATA_DIR=data

# Pace: at least GAP_SECONDS between two messages, plus up to JITTER_SECONDS; at most DAILY_LIMIT a day.
# GAP_SECONDS=8
# JITTER_SECONDS=7
# DAILY_LIMIT=200

# A message still waiting after this many hours is dropped (and the team emailed).
# MAX_AGE_HOURS=12

# Starting or loading without progress for this many minutes: start again (the link is kept).
# STALL_MINUTES=3

# true: nothing goes to WhatsApp; every message is marked sent (for testing the website).
# DRY_RUN=false

# Chrome: the one Puppeteer downloaded unless set (on Ubuntu, Google Chrome's: /usr/bin/google-chrome).
# CHROME_PATH=
# Only if Chrome can't start ("No usable sandbox"); see README.md.
# CHROME_NO_SANDBOX=false

# Pin a WhatsApp Web version (e.g. 2.3000.1051815529) when a WhatsApp update breaks whatsapp-web.js.
# WA_WEB_VERSION=
